# =============================================================================
# 247sales AI Agents Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Twitter API (free tier) ---
# Get your bearer token at https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# --- Notification: Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=your@email.com

# --- Notification: Slack ---
SLACK_WEBHOOK_URL=

# --- Notification: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduling (cron expressions) ---
AI_TRENDS_CRON=0 */2 * * *
TWITTER_SEO_CRON=*/15 * * * *
DIGEST_CRON=0 8 * * *
TIMEZONE=America/New_York

# --- Summarization ---
# Options: "extractive" (free, no API key) or "llm" (requires OpenAI key or Ollama)
SUMMARIZER_MODE=extractive
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
DATABASE_URL=sqlite:///data/247sales.db
